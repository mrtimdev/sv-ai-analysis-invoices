# Optional default environment variables for Vercel deployment
# (Users can also configure/override all of these in the in-app Settings modal)

# Unauthenticated /v1 Scan Backend Server Base URL
VITE_API_SERVER_BASE=http://localhost:8080
VITE_V1_LIST_SCANS_PATH=/v1/list/scans
VITE_V1_SINGLE_SCAN_PATH=/v1/{scanId}/scan

# Optional AI Vision API defaults (OpenAI-compatible endpoint)
VITE_AI_API_BASE=
VITE_AI_API_KEY=
VITE_AI_MODEL=antigravity/gemini-3.8-flash-low
